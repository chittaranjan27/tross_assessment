# LinkedIn Configuration
# These are required to access LinkedIn's private APIs
LINKEDIN_SESSION_COOKIE=li_at_placeholder
LINKEDIN_CSRF_TOKEN=JSESSIONID_placeholder
LINKEDIN_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.0.0 Safari/537.36"

# Redis Configuration for Caching and Rate Limiting
REDIS_URL=redis://localhost:6379/0

# API Settings
API_KEY=test_api_key_for_rate_limiting
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=21600
UPSTREAM_TIMEOUT_SECONDS=20

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
